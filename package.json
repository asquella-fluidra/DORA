{
  "name": "dora-etl-dashboard",
  "version": "1.0.0",
  "description": "B2B ETL Dashboard with DORA metrics",
  "scripts": {
    "build": "tsc",
    "build:cdk": "npx tsc --project tsconfig.cdk.json",
    "test": "npm run build:cdk && vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "test:coverage": "vitest run --coverage",
    "cdk:ls": "npm run build:cdk && npx cdk ls",
    "cdk:synth": "npm run build:cdk && npx cdk synth",
    "cdk:deploy": "npm run build:cdk && npx cdk deploy",
    "cdk:destroy": "npm run build:cdk && npx cdk destroy",
    "cdk:diff": "npm run build:cdk && npx cdk diff"
  },
  "keywords": [
    "dora",
    "etl",
    "dashboard"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.500.0",
    "@eslint/js": "^9.39.2",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitest/coverage-v8": "^4.0.18",
    "aws-cdk-lib": "^2.237.1",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18",
    "zod": "^4.3.6"
  },
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asquella-fluidra/DORA.git"
  },
  "bugs": {
    "url": "https://github.com/asquella-fluidra/DORA/issues"
  },
  "homepage": "https://github.com/asquella-fluidra/DORA#readme",
  "dependencies": {
    "constructs": "^10.4.5"
  }
}
